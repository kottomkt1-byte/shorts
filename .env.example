# No env vars are required in local mode. Export these before starting the process.
AUTO_SHORTS_DATA=./data
AUTO_SHORTS_EMBEDDED_WORKER=1
AUTO_SHORTS_CONCURRENCY=1
AUTO_SHORTS_QUOTA_MB=10240
AUTO_SHORTS_MAX_UPLOAD_MB=500
AUTO_SHORTS_TTL_HOURS=72
# AUTO_SHORTS_FONT=/path/to/Korean-font.ttf
# AUTO_SHORTS_SCANNER=/usr/bin/clamscan
# AUTO_SHORTS_REQUIRE_SCAN=1
# Named accounts, for a private authenticated deployment (replace with strong random tokens):
# AUTO_SHORTS_ACCOUNTS={"editor":"replace-with-random-token"}
# AUTO_SHORTS_SECURE_COOKIE=1
# AUTO_SHORTS_HOSTS=studio.example.com
# AUTO_SHORTS_ORIGINS=https://studio.example.com
# Optional, explicitly requested Vision analysis only; billable external API:
# OPENAI_API_KEY=
# AUTO_SHORTS_VISION_MODEL=gpt-4o-mini
# Optional local ASR (install faster-whisper and download a model separately):
# AUTO_SHORTS_ASR_MODEL=/absolute/path/to/faster-whisper-model
